+              </dl>
+            </section>
+          </div>
+
+          <PilotKillDate lang={lang} />
+
+          <div className="prose">
+            <section>
+              <h2>{lang === 'de' ? 'Architektur' : 'Architecture'}</h2>
+              <p>{product.architecture[lang]}</p>
