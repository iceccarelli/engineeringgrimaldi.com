+.mega-group h3 { margin: 0 0 .7rem; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--trace-2); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
+.mega-group ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .15rem; }
