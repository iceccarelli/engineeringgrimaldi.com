+.crumbs a:hover { color: var(--phosphor); }
+.crumbs [aria-current='page'] { color: var(--text); }
+
+/* ── Index pages & pricing ──────────────────────────────────────────── */
+.index-group { margin-top: 2.6rem; }
+.index-group h2, .index-group-h { font-size: 1.1rem; margin-bottom: 1rem; }
+.tool-band-static { display: block; }
+.tool-band-static p { margin: 0 0 .8rem; }
+.price-card { gap: .25rem; }
+.price-figure { font-size: 1.9rem; font-weight: 700; color: var(--phosphor); margin: .3rem 0 0 !important; font-variant-numeric: tabular-nums; flex: none !important; }
+.price-unit { font-size: .78rem; color: var(--muted); margin: 0 0 .6rem !important; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; flex: none !important; }
+
+/* ── Footer as full site index ──────────────────────────────────────── */
+.foot-columns { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 2rem; padding-bottom: 2.5rem; border-bottom: 1px solid var(--border); }
+.foot-col h4 { margin: 0 0 .8rem; font-size: .82rem; }
+.foot-col h4 a { color: var(--text); }
+.foot-col h4 a:hover { color: var(--phosphor); }
+.foot-col ul { list-style: none; margin: 0 0 .8rem; padding: 0; }
+.foot-col li { margin-bottom: .5rem; }
+.foot-col a { font-size: .84rem; color: var(--text-2); }
+.foot-col a:hover { color: var(--phosphor); }
+.foot-base { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 2.5rem; padding: 2.5rem 0; }
+.foot-base-links h4 { margin: 0 0 1rem; font-size: .9rem; }
+.foot-base p { max-width: 46ch; }
+
+@media (min-width: 981px) {
+  .mega { display: block; }
+  .drawer-toggle { display: none; }
+}
+@media (max-width: 980px) {
+  .masthead-in { padding: .5rem 1rem; }
