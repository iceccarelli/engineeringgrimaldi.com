+.mega-group span { display: block; font-size: .82rem; color: var(--muted); line-height: 1.5; margin-top: .15rem; }
+.mega-all { display: inline-block; max-width: var(--max); margin: 1.3rem auto 0; padding: 0 .25rem; font-size: .86rem; font-weight: 650; color: var(--phosphor); }
+
