+.drawer-toggle { width: 42px; height: 42px; border-radius: 10px; border: 1px solid var(--border-strong); background: transparent; color: var(--text); cursor: pointer; display: grid; place-items: center; }
+.drawer-toggle:hover { border-color: var(--phosphor); }
+.burger { display: grid; gap: 4px; width: 18px; }
+.burger i { display: block; height: 2px; background: currentColor; border-radius: 2px; transition: transform .18s ease, opacity .18s ease; }
+.burger.open i:nth-child(1) { transform: translateY(6px) rotate(45deg); }
+.burger.open i:nth-child(2) { opacity: 0; }
+.burger.open i:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
+
+.drawer {
+  position: fixed; top: 0; right: 0; bottom: 0; z-index: 60;
+  width: min(400px, 88vw); overflow-y: auto;
+  background: var(--panel); border-left: 1px solid var(--border-strong);
+  padding: 1.2rem 1.1rem 3rem;
+  box-shadow: -16px 0 50px rgba(0,0,0,.55);
+}
+.drawer-scrim { position: fixed; inset: 0; z-index: 50; background: rgba(2,4,7,.65); }
+.drawer-section { border-bottom: 1px solid var(--border); }
+.drawer-row { display: flex; align-items: center; }
