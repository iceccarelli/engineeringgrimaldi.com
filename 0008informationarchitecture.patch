+.mega-trigger:hover, .mega-trigger:focus-visible { color: var(--text); background: rgba(255,255,255,.04); }
+.mega-trigger.on { color: var(--phosphor); }
+.mega-panel {
+  position: absolute; left: 0; right: 0; top: 100%;
+  background: var(--panel); border-top: 1px solid var(--border);
+  border-bottom: 1px solid var(--border-strong);
+  box-shadow: 0 24px 60px rgba(0,0,0,.55);
+  padding: 1.6rem 1.5rem 1.8rem;
+}
+.mega-blurb { max-width: var(--max); margin: 0 auto 1.2rem; padding: 0 .25rem; color: var(--text-2); font-size: .9rem; line-height: 1.6; }
