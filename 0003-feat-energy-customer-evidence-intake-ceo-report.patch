diff --git a/.github/workflows/ceo-report.yml b/.github/workflows/ceo-report.yml
new file mode 100644
index 0000000..d04aaf6
--- /dev/null
+++ b/.github/workflows/ceo-report.yml
@@ -0,0 +1,40 @@
+name: Weekly CEO report
+
+# Every Friday 15:00 UTC (17:00 Berlin summer time). Generates the ten-section
+# report from the live control engine and opens a pull request. A human fills
+# in DECISIONS (addendum) and NEXT 7 DAYS in the PR, then merges. D-013.
+
+on:
+  schedule:
+    - cron: '0 15 * * 5'
+  workflow_dispatch:
+
+permissions:
+  contents: write
+  pull-requests: write
+
+jobs:
+  report:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 20
+      - name: Generate report from /api/energy/*
+        run: node scripts/ceo-report.mjs
+        env:
+          BASE: https://engineeringgrimaldi.com
+      - name: Open pull request
+        uses: peter-evans/create-pull-request@v6
+        with:
+          branch: ceo-report/${{ github.run_id }}
+          commit-message: 'report(energy): weekly CEO report'
+          title: 'CEO report — Energy Intelligence — week of ${{ github.run_started_at }}'
+          body: |
+            Generated by `scripts/ceo-report.mjs` from the live control engine.
+
+            Before merging, fill in section 8 (human addendum) and section 10 (NEXT 7 DAYS — three lines, each ending in a number).
+            If a KPI changed, change the constant in `lib/energy/kpis.ts` in the same PR, with its source.
+          labels: ceo-report
+          add-paths: docs/energy/reports/*.md
