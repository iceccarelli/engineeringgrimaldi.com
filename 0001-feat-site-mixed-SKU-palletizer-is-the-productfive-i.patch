+.scope-readout span { display: block; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: #8FA0B3; }
+.scope-readout strong { font-size: 15px; color: var(--coal-ink); }
+.scope-warn strong { color: var(--hold); }
+.scope-alarm strong { color: #FF6B80; }
+.scope-controls { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding: 16px; border-top: 1px solid #3A4450; }
+.scope-controls label { display: flex; flex-direction: column; gap: 6px; font-family: var(--mono); font-size: 12px; }
+.scope-controls input[type='range'] { accent-color: var(--signal); }
+.scope-caption { margin: 0; padding: 0 16px 16px; font-family: var(--mono); font-size: 12px; color: #8FA0B3; }
+
+/* Waitlist component (unmounted from header-linked pages, kept styled) */
+.wl-form { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; }
+.wl-field { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--muted); min-width: 220px; }
+.wl-honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
+.wl-ok { color: var(--live); font-weight: 600; }
+.wl-error { flex-basis: 100%; color: var(--fault); margin: 0; }
+.wl-privacy { flex-basis: 100%; color: var(--muted); font-size: 12px; margin: 0; }
+
+/* ── Stack planner (home hero + /palletizer) ───────────────────────── */
+.sp { border: 1px solid var(--line); border-radius: var(--r); background: var(--panel); overflow: hidden; }
+.sp-grid { display: grid; grid-template-columns: minmax(280px, 380px) 1fr; }
+.sp-in { padding: 16px; border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 12px; }
+.sp-in textarea { min-height: 200px; resize: vertical; font-family: var(--mono); font-size: 13px; line-height: 1.5; white-space: pre; overflow: auto; }
+.sp-file { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--muted); }
+.sp-file input[type='file'] { padding: 6px; font-size: 12px; }
+.sp-pallet { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
+.sp-pallet label { font-size: 12px; color: var(--muted); }
+.sp-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
+.sp-out { padding: 16px; display: grid; grid-template-columns: 1fr minmax(220px, 280px); gap: 16px; }
+.sp-map { background: var(--coal); color: var(--coal-ink); border-radius: var(--r); padding: 12px; }
+.sp-map-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-family: var(--mono); font-size: 12px; color: #8FA0B3; margin-bottom: 8px; }
+.sp-map-head strong { color: var(--coal-ink); font-weight: 500; }
+.sp-layer-tabs { display: flex; flex-wrap: wrap; gap: 4px; }
+.sp-layer-tabs button { min-height: 28px; padding: 0 8px; border-radius: var(--r-chip); border: 1px solid #3A4450; background: transparent; color: #8FA0B3; font-family: var(--mono); font-size: 12px; cursor: pointer; }
+.sp-layer-tabs button:hover { border-color: var(--coal-ink); color: var(--coal-ink); }
+.sp-layer-tabs button[aria-pressed='true'] { background: var(--coal-ink); color: var(--coal); border-color: var(--coal-ink); }
+.sp-svg { width: 100%; height: auto; display: block; }
+.sp-deck { fill: #161B22; stroke: #3A4450; stroke-width: 3; }
+.sp-box { fill: #2B3440; stroke: #B8C4D2; stroke-width: 2.5; transition: x var(--t-map) ease, y var(--t-map) ease, width var(--t-map) ease, height var(--t-map) ease, fill var(--t-map) ease; }
+.sp-box-rot { fill: #23303E; }
+.sp-box-heavy { fill: #3A2A14; stroke: var(--signal); }
+.sp-box-fault { fill: #3B141C; stroke: #FF6B80; }
+.sp-box-label { fill: var(--coal-ink); font-family: var(--mono); font-size: 34px; text-anchor: middle; dominant-baseline: middle; pointer-events: none; }
+.sp-dim { fill: #8FA0B3; font-family: var(--mono); font-size: 30px; text-anchor: middle; }
+.sp-com { fill: none; stroke: var(--signal); stroke-width: 3; }
+.sp-com-dot { fill: var(--signal); }
+.sp-stats { display: flex; flex-direction: column; gap: 12px; }
+.sp-tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
+.sp-tiles .sp-tile:first-child { grid-column: 1 / -1; }
+.sp-tile { border: 1px solid var(--line); border-radius: var(--r); padding: 10px 12px; }
+.sp-tile span { display: block; font-size: 11px; color: var(--muted); letter-spacing: .04em; text-transform: uppercase; font-family: var(--mono); }
+.sp-tile strong { display: block; font-family: var(--mono); font-size: 20px; font-weight: 500; font-variant-numeric: tabular-nums; line-height: 1.2; }
+.sp-tiles .sp-tile:first-child strong { font-size: 28px; }
+.sp-tile-ok strong { color: var(--live); }
+.sp-tile-hold strong { color: #7A6400; }
+.sp-tile-fault strong { color: var(--fault); }
+.sp-faults { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 6px; }
+.sp-faults li { font-family: var(--mono); font-size: 12px; padding: 6px 8px; border-radius: var(--r-chip); border-left: 3px solid var(--fault); background: var(--paper); }
+.sp-faults li.hold { border-left-color: var(--hold); }
+.sp-faults li.ok { border-left-color: var(--live); color: var(--muted); }
+.sp-state { display: flex; gap: 4px; }
+.sp-state .chip { border-color: var(--line); color: var(--muted); }
+.sp-state .chip[data-on='true'].chip-idle { border-color: var(--ink); color: var(--ink); }
+.sp-state .chip[data-on='true'].chip-live { border-color: var(--live); color: var(--live); background: #E6F3EC; }
+.sp-state .chip[data-on='true'].chip-hold { border-color: var(--hold); color: #7A6400; background: #FBF6DC; }
+.sp-state .chip[data-on='true'].chip-fault { border-color: var(--fault); color: var(--fault); background: #FBE5E9; }
+.sp-foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 16px; padding: 10px 16px; border-top: 1px solid var(--line); font-family: var(--mono); font-size: 12px; color: var(--muted); }
+.sp-export { display: flex; flex-wrap: wrap; gap: 8px; }
+.sp-export .btn { min-height: 32px; font-size: 13px; }
+.sp-script { margin-top: 12px; }
+.sp-script summary { cursor: pointer; font-family: var(--mono); font-size: 12px; color: var(--muted); }
+.sp-script pre { margin-top: 8px; max-height: 260px; }
+
+/* Honesty line */
+.honesty { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; font-family: var(--mono); font-size: 13px; padding: 12px 0; }
+.honesty .sep { color: var(--line); }
+
+/* Doors */
+.doors { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
+.door { display: block; border: 1px solid var(--line); border-radius: var(--r); background: var(--panel); padding: 20px; }
+.door:hover { border-color: var(--ink); text-decoration: none; }
+.door .kicker { margin-bottom: 8px; }
+.door h3 { font-size: 18px; margin: 0 0 8px; }
+.door p { color: var(--muted); margin: 0 0 12px; }
+.door .cta { font-weight: 600; font-size: 13px; }
+
+/* Intake */
+.intake { border: 1px solid var(--line); border-radius: var(--r); background: var(--panel); padding: 24px; max-width: 760px; }
+.intake-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; }
+.intake-grid .wide { grid-column: 1 / -1; }
+.intake-grid label { display: block; font-size: 12px; color: var(--muted); }
+.intake-note { color: var(--muted); font-size: 12px; margin: 12px 0 0; }
+.intake-ok { border-left: 3px solid var(--live); padding: 8px 12px; background: #E6F3EC; font-weight: 600; }
+.intake-err { border-left: 3px solid var(--fault); padding: 8px 12px; background: #FBE5E9; }
+.intake-err code { user-select: all; }
+#received:not(:target), #error:not(:target) { display: none; }
+
+/* Adapter table & diagram */
+.adapter-ok { color: var(--live); font-weight: 600; }
+.adapter-plan { color: var(--muted); }
+.diagram { background: var(--panel); border: 1px solid var(--line); border-radius: var(--r); padding: 16px; }
+.diagram svg { width: 100%; height: auto; display: block; }
+.diagram-caption { font-family: var(--mono); font-size: 12px; color: var(--muted); margin: 8px 0 0; }
+
+/* Definition lists (docs) */
+.defs { display: grid; grid-template-columns: max-content 1fr; gap: 8px 24px; margin: 0 0 16px; }
+.defs dt { font-family: var(--mono); font-size: 13px; }
+.defs dd { margin: 0; color: var(--muted); }
+
