+    treeH2: 'Zielbaum',
+    modulesH2: 'Module',
+    th: ['Modul', 'Aus', 'Zweck', 'Getrennt, weil', 'Art', 'Zustand'],
+    sepH2: 'Harte Trennungsauslöser',
+    sepLead: 'Komponenten bleiben isoliert, wenn Kopplung eines davon erzeugen würde:',
+    primH2: 'Gemeinsame Primitive',
