+.calc-alts ul { margin: 0; padding-left: 1.1rem; color: var(--text-2); font-size: .84rem; line-height: 1.6; }
+.calc-download { margin-top: 1.2rem; cursor: pointer; font-family: inherit; }
+.calc-error { color: var(--trace-3); font-size: .9rem; line-height: 1.6; }
+.calc-disclaimer { margin: 0; padding: 1rem 1.5rem 1.3rem; border-top: 1px solid var(--border); color: var(--muted); font-size: .78rem; line-height: 1.6; }
+
+@media (max-width: 980px) {
+  .calc-inputs, .calc-output { grid-template-columns: 1fr; }
+  .calc-inputs fieldset { grid-template-columns: 1fr 1fr; }
+}
