+            name: f.q,
+            acceptedAnswer: { '@type': 'Answer', text: f.a },
+          })),
+        }}
+      />
+      <JsonLd
+        data={breadcrumbSchema(lang, [
+          { name: 'Grimaldi Engineering', path: '/' },
+          { name: lang === 'de' ? 'Werkzeuge' : 'Tools', path: '/tools' },
+          { name: copy.h1, path: PATH },
+        ])}
+      />
+    </main>
+  );
+}
